APP_NAME="BOA PDF"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Database (compose service hostname: mysql)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=boa_pdf
DB_USERNAME=boa
DB_PASSWORD=change-me

# MySQL container bootstrap (used by docker-compose mysql service)
MYSQL_DATABASE=boa_pdf
MYSQL_USER=boa
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# Redis (compose service hostname: redis)
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

MAIL_MAILER=smtp
MAIL_HOST=mail.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# BOA PDF limits (kilobytes for Laravel validation; ~50 MB)
PDF_MAX_FILE_SIZE=51200
PDF_TEMP_CLEANUP_HOURS=24
PDF_UPLOAD_RETENTION_DAYS=30
PDF_DEFAULT_COMPRESSION=recommended

# Conversion tools (image defaults; compose may override)
GHOSTSCRIPT_PATH=/usr/bin/gs
QPDF_PATH=/usr/bin/qpdf
LIBREOFFICE_PATH=/usr/bin/soffice
PDFINFO_PATH=/usr/bin/pdfinfo
PDFTOCAIRO_PATH=/usr/bin/pdftocairo
PDFTOTEXT_PATH=/usr/bin/pdftotext
OCRMYPDF_PATH=/usr/bin/ocrmypdf
PDF2DOCX_PATH=/var/www/html/.venv/bin/pdf2docx
PDF_CONVERSION_IMAGE_DPI=300
PDF_CONVERSION_JPEG_QUALITY=95
PDF_CONVERSION_OCR_ENABLED=true
PDF_CONVERSION_OCR_LANGUAGE=eng
PDF_CONVERSION_OCR_JOBS=2
PDF_CONVERSION_DOCX_JOBS=2
PDF_CONVERSION_PROCESS_TIMEOUT=120
PDF_CONVERSION_DOCUMENT_TIMEOUT=900
PDF_CONVERSION_OCR_TIMEOUT=1800

ILOVEPDF_PUBLIC_KEY=
ILOVEPDF_SECRET_KEY=

VITE_APP_NAME="${APP_NAME}"

APP_NAME="BOA PDF"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://powerhouse.test

# BOA Theme (packages/boa-theme) — presets: solar-stele, midnight, coastal, ember
BOA_THEME_PRESET=solar-stele
# BOA_THEME_BRAND=#0f766e
# BOA_THEME_ACCENT=#d97706
# BOA_THEME_CANVAS=#78716c
# BOA_THEME_NAME="${APP_NAME}"
# BOA_THEME_TAGLINE="Your library, illuminated"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production: SESSION_SECURE_COOKIE=true
SESSION_SECURE_COOKIE=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Shared object storage for multi-node: set FILESYSTEM_DISK=s3 and DOCUMENTS_DISK=s3
DOCUMENTS_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# BOA PDF - max upload in kilobytes for Laravel validation (51200 ≈ 50 MB)
PDF_MAX_FILE_SIZE=51200
PDF_TEMP_CLEANUP_HOURS=24
PDF_UPLOAD_RETENTION_DAYS=30
PDF_DEFAULT_COMPRESSION=recommended

# Optional: external tools
GHOSTSCRIPT_PATH=
QPDF_PATH=
LIBREOFFICE_PATH=
PDFINFO_PATH=
PDFTOCAIRO_PATH=
PDFTOTEXT_PATH=
OCRMYPDF_PATH=
PDF2DOCX_PATH=
PDF_CONVERSION_IMAGE_DPI=300
PDF_CONVERSION_JPEG_QUALITY=95
PDF_CONVERSION_OCR_ENABLED=true
PDF_CONVERSION_OCR_LANGUAGE=eng
PDF_CONVERSION_OCR_JOBS=2
PDF_CONVERSION_DOCX_JOBS=2
PDF_CONVERSION_PROCESS_TIMEOUT=120
PDF_CONVERSION_DOCUMENT_TIMEOUT=900
PDF_CONVERSION_OCR_TIMEOUT=1800

VITE_APP_NAME="${APP_NAME}"
